msgstr "ARP I-401"

msgid "IDS_PJSX701_FULL"
msgstr "ARP I-401"

msgid "IDS_PJSX702"
msgstr "ARP I-401"

msgid "IDS_PJSX702_FULL"
msgstr "ARP I-401"

msgid "IDS_PJSX799"
msgstr "707R"

msgid "IDS_PJUA002_140_50_TYPE3"
msgstr "140 mm/50 Type3"

msgid "IDS_PJUA003_C1_ART_STOCK"
