msgid "IDS_PCVE030_HOUND_BATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "PORTALS"

msgid "IDS_PCVE030_HOUND_BATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Travel to the opposite side of the map using portals."

msgid "IDS_PCVE030_HOUND_BATTLE_RULES_PARAGRAPH_3_HEADER"
msgstr "CONTROL POINTS"

msgid "IDS_PCVE030_HOUND_BATTLE_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Capture points to weaken Ermelinda's defense and slow the evacuation system charging. When fully charged, Ermelinda wins!"

msgid "IDS_PCVE030_MATCHMAKER_DESCRIPTION"
msgstr "Grimsby Islands"

msgid "IDS_PCVE030_START_TASK_HOUND"
msgstr "Destroy Ermelinda's ship before the evacuation system launches"

msgid "IDS_PCVE030_START_TASK_WAFFENTRAGER"
msgstr "Charge the evacuation system without letting the Hounds destroy you"

msgid "IDS_PCVE030_SUBHEADER"
msgstr " "

