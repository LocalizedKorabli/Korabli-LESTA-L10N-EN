msgid "IDS_WT_PROGRESS_ONBOARDING_TEXT_1"
msgstr "<p>[AK] <span class=\"currency\">Activation Keys</span> are needed to sortie on Ermelinda's ships.</p><p class=\"p_spacing\"> </p><p>[PR] <span class=\"currency\">Reactor alloys</span> can be used to buy bonuses on the 'Bureau of Experimental Technology' screen.</p><p class=\"p_spacing\"> </p><p>[PC] <span class=\"currency\">Power cells</span> and [PR] <span class=\"currency\">reactor alloys</span> can be spent in the Armory on various rewards.</p>"

msgid "IDS_WT_PROGRESS_ONBOARDING_TEXT_2"
msgstr "<p>On some progress levels, you will be offered a choice of one of two rewards.</p><p class=\"p_spacing\"> </p><p>If you pass all progress levels before Resonance, you can receive all rewards that were not chosen earlier.</p>"

