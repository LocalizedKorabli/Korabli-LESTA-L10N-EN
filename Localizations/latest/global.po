msgstr "RETURN TO BATTLE"

msgid "IDS_PCVE030_WAFFENTRAGER_BATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "The Alliance possesses regeneration technologies: all destroyed Hounds can return to battle."

msgid "IDS_PCVE030_WAFFENTRAGER_BATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "PORTALS"

msgid "IDS_PCVE030_WAFFENTRAGER_BATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Travel to the opposite side of the map using portals."

