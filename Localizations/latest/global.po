msgstr "The more ships in your Port, the greater the maximum number of rewards you can collect from a single battle."

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_2_TEXT_3"
msgstr ""
"  • 100 ships: +1 rewards for 350 XP;\n"
"  • 200 ships: +2 rewards for 400 XP;\n"
"  • 300 ships: +3 rewards for 450 XP."

