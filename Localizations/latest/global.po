msgstr "Trials"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_3_TEXT_1"
msgstr "To reach each 10th mastery level, you must complete trials that are tailored for each ship based on its tactical role."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_3_TEXT_2"
msgstr "You can reset your trials and get new ones at any time."

