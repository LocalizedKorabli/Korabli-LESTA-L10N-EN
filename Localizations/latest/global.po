msgid "IDS_DOGTAG_PCNB223_NAME"
msgstr "USS Batfish"

msgid "IDS_DOGTAG_PCNB224_DESCRIPTION"
msgstr "Wukong is the king of monkeys and one of the main mythological characters in Chinese culture, as well as the hero of the novel \"Journey to the West\" by the Chinese writer Wu Cheng'en."

