msgid "IDS_DIVISION_READY"
msgstr "The Division is ready"

msgid "IDS_DOBROJIR_DROBODANOVICH"
msgstr "Dobrozhir Drobojanovich"

msgid "IDS_DOCK"
msgstr "Port"

msgid "IDS_DOCK_AMMO_DESCRIPTION_AIRSUPPORT_DEPTHCHARGE"
msgstr "<p>Conducts a depth charge bombardment of the marked area.</p><p class=\"p_spacing\"> </p><p>Depth charges remain in the water for a certain time and explode near submarines or other targets. Have a chance to cause fire, flooding, and disable modules. Have an increased chance to disable sonar. Destroy torpedoes and mines, and also deal minor damage to surface targets.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_AIRSUPPORT_DEPTHCHARGE_AUTO"
msgstr "<p>Automatically conducts a depth charge bombardment of the area where a submarine is presumed to be if it reveals its location.</p><p class=\"p_spacing\"> </p><p>Depth charges remain in the water for a certain time and explode near submarines or other targets. Have a chance to cause fire, flooding, and disable modules. Have an increased chance to disable sonar. Destroy torpedoes and mines, and also deal minor damage to surface targets.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_AIRSUPPORT_FIGHTER_FIGHTER"
msgstr "Automatically attack enemy aircraft in the selected area."

msgid "IDS_DOCK_AMMO_DESCRIPTION_AIRSUPPORT_HE"
msgstr "<p>Conducts a bombardment of the designated area with high-explosive bombs.</p><p class=\"p_spacing\"> </p><p>High-explosive bombs can cause fires and incapacitate modules.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_AIRSUPPORT_SCOUT_SCOUT"
msgstr "Increase the range and accuracy of main battery fire for a selected allied ship."

msgid "IDS_DOCK_AMMO_DESCRIPTION_AIRSUPPORT_SCOUT_SMOKE"
msgstr "Deploy a smoke screen in a selected area. The smoke screen reduces the chance of detection by the enemy."

msgid "IDS_DOCK_AMMO_DESCRIPTION_AIRSUPPORT_SCOUT_SPY"
msgstr "Detect enemy ships from aircraft at their detection range."

msgid "IDS_DOCK_AMMO_DESCRIPTION_AIRSUPPORT_SEAMINE"
msgstr "<p>Mines stay on the water surface for a certain amount of time and explode upon contact with ships.</p><p class=\"p_spacing\"> </p><p>Can cause flooding and incapacitate modules.</p><p class=\"p_spacing\"> </p><p>Most effective against large and less maneuverable targets.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_AP"
msgstr "<p>Deals significant damage by penetrating the armor and exploding inside the ship.</p><p class=\"p_spacing\"> </p><p>The closer the distance to the target at the moment of salvo, the higher the penetration. They have a chance of ricochet and over-penetration.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_AP_ACID_FIRST_APRIL23"
msgstr ""
"Effective against heavily armored targets and deal considerable damage.\n"
"\n"
"Can leave holes in the citadels of even toy ships, let alone rubber duckies..."

msgid "IDS_DOCK_AMMO_DESCRIPTION_AP_EVENT_HW20"
msgstr ""
"Effective against heavily armored targets. Penetrates armor and explodes inside the ship, causing considerable damage.\n"
"\n"
"If the armor is not thick enough, the shells will overpenetrate and cause significantly less damage.\n"
"\n"
"Armor will cause these shells to ricochet if they impact at a sharp angle."

msgid "IDS_DOCK_AMMO_DESCRIPTION_AP_SEC"
msgstr "<p>Penetrates heavily armored targets, explodes inside the ship, and deals significant damage.</p><p class=\"p_spacing\"> </p><p>If the armor is too thin, the shell will pass through the ship, dealing minor damage.</p><p class=\"p_spacing\"> </p><p>Armor causes ricochet when a shell hits at a sharp angle.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_AXISLASER"
msgstr ""
"Features:\n"
" • Accumulates charge before release\n"
" • Releases a series of powerful laser pulses\n"
" • Most effective at medium and short ranges against slow-moving targets"

msgid "IDS_DOCK_AMMO_DESCRIPTION_BOMBER_DEEPWATER"
msgstr "<p>Attacks the target with deepwater torpedoes.</p><p class=\"p_spacing\"> </p><p>Deepwater torpedoes have low visibility but only hit ships with a deep draft.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_BOMBER_TORPEDO"
msgstr "<p>Attacks the target with torpedoes.</p><p class=\"p_spacing\"> </p><p>Torpedoes deal significant damage and can cause flooding.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_BOMBER_TORPEDO_ALT"
msgstr "<p>Attacks the target with torpedoes.</p><p class=\"p_spacing\"> </p><p>Torpedoes deal significant damage and can cause flooding.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_BOMBER_TORPEDO_DEEPWATER"
msgstr "<p>Attack the target with deepwater torpedoes.</p><p class=\"p_spacing\"> </p><p>Hit only deep-draught ships.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_BOMBER_TORPEDO_DEEPWATER_ALT"
msgstr "<p>Attacks the target with deepwater torpedoes.</p><p class=\"p_spacing\"> </p><p>Deepwater torpedoes have low visibility but only hit ships with a deep draft.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_CHARGELASER"
msgstr ""
"Features:\n"
" • The shot is preceded by an energy build-up; remains locked onto the targeted sector\n"
"\n"
"Most effective at long range against slow-moving targets."

msgid "IDS_DOCK_AMMO_DESCRIPTION_CS"
msgstr "<p>Deals significant damage by penetrating the armor and exploding inside the ship.</p><p class=\"p_spacing\"> </p><p>Armor penetration is higher than that of high-explosive shells and is not dependent on distance. They have a reduced chance of ricochet.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_CS_SEC"
msgstr "<p>Targets lightly armored targets and deals significant damage.</p><p class=\"p_spacing\"> </p><p>No damage is dealt upon non-penetration and ricochets.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_DEPTHCHARGE"
msgstr "<p>Remain in the water for a certain time and explode near submarines or other targets.</p><p class=\"p_spacing\"> </p><p>Have a chance to cause fire, flooding, and disable modules. Have an increased chance to disable sonar.</p><p class=\"p_spacing\"> </p><p>Destroy torpedoes and mines, and also deal minor damage to surface targets.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_DEPTHCHARGE_ACID_FIRST_APRIL23"
msgstr ""
"Deployed in water and deal damage on contact. Effective at keeping hostile duckies at bay. Self-destruct 30 s after deployment.\n"
"\n"
"These splashy mines will help you relax after a hard day's work."

msgid "IDS_DOCK_AMMO_DESCRIPTION_DIVE_AP"
msgstr "<p>Attacks the target with a series of armor-piercing bombs.</p><p class=\"p_spacing\"> </p><p>Armor-piercing bombs deal significant damage by penetrating the armor and exploding inside the ship.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_DIVE_AP_ALT"
msgstr "<p>Attacks the target with a series of armor-piercing bombs.</p><p class=\"p_spacing\"> </p><p>Armor-piercing bombs deal significant damage by penetrating the armor and exploding inside the ship.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_DIVE_HE"
msgstr "<p>Attacks the target with a series of high-explosive bombs.</p><p class=\"p_spacing\"> </p><p>High-explosive bombs can cause fires and incapacitate modules.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_DIVE_HE_ALT"
msgstr "<p>Attacks the target with a series of high-explosive bombs.</p><p class=\"p_spacing\"> </p><p>High-explosive bombs can cause fires and incapacitate modules.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_DRUM_MODE"
msgstr "Burst Fire Mode allows multiple shots in quick succession."

msgid "IDS_DOCK_AMMO_DESCRIPTION_FIGHTER_AP"
msgstr "<p>Attacks the target with armor-piercing rockets.</p><p class=\"p_spacing\"> </p><p>Armor-piercing rockets deal significant damage by penetrating the armor and exploding inside the ship.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_FIGHTER_AP_ALT"
msgstr "<p>Attacks the target with armor-piercing rockets.</p><p class=\"p_spacing\"> </p><p>Armor-piercing rockets deal significant damage by penetrating the armor and exploding inside the ship.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_FIGHTER_HE"
msgstr "<p>Attacks the target with high-explosive rockets.</p><p class=\"p_spacing\"> </p><p>High-explosive rockets can cause fires and incapacitate modules.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_FIGHTER_HE_ALT"
msgstr "<p>Attacks the target with high-explosive rockets.</p><p class=\"p_spacing\"> </p><p>High-explosive rockets can cause fires and incapacitate modules.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_HE"
msgstr "<p>Can cause fires and incapacitate modules.</p><p class=\"p_spacing\"> </p><p>Armor penetration is low and does not depend on distance.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_HE_ACID_EVENT_HW20"
msgstr "Effective against lightly armored targets and deals significant potential damage. Cause acid-induced damage and have a high potential to incapacitate modules. "

msgid "IDS_DOCK_AMMO_DESCRIPTION_HE_ACID_FIRST_APRIL23"
msgstr ""
"Effective against lightly armored duckies and deal considerable potential damage.\n"
"\n"
"Have high chances of causing flooding with no sting in your eye."

msgid "IDS_DOCK_AMMO_DESCRIPTION_HE_BOMB_EVENT_HW20"
msgstr ""
"Effective against lightly armored targets and deals significant potential damage.\n"
"\n"
"Has a huge damage area radius."

msgid "IDS_DOCK_AMMO_DESCRIPTION_HE_EVENT_HW20"
msgstr ""
"Effective against lightly armored targets.\n"
"\n"
"These shells have the potential to deal significant damage and high chances of causing fire or incapacitating modules."

msgid "IDS_DOCK_AMMO_DESCRIPTION_HE_SEC"
msgstr "<p>Targets lightly armored targets and deals significant potential damage.</p><p class=\"p_spacing\"> </p><p>Has a high chance of setting the ship on fire and disabling modules.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_IMPULSELASER"
msgstr "<p>The beams are dual-purpose: they can damage enemies and heal allies.</p><p class=\"p_spacing\"> </p><p>You can cease firing before the laser is completely discharged in order to reduce the recharge time.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_MANUALAIRDEFENSE"
msgstr "<p>Creates an area in the sky where enemy squadrons take damage and lose firing accuracy.</p><p class=\"p_spacing\"> </p><p>Only active within the ship's AA defense zone. Activate the barrage when you see a red airplane icon.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_MINEFIELD"
msgstr "<p>Mines stay on the water surface for a certain amount of time and explode upon contact with ships.</p><p class=\"p_spacing\"> </p><p>Can cause flooding and incapacitate modules.</p><p class=\"p_spacing\"> </p><p>Most effective against large and less maneuverable targets.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_MINE_SEAMINE"
msgstr "<p>Lays a minefield in the designated area.</p><p class=\"p_spacing\"> </p><p>Mines can cause flooding and incapacitate modules.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_MINE_SEAMINE_ALT"
msgstr "<p>Lays a minefield in the designated area.</p><p class=\"p_spacing\"> </p><p>Mines can cause flooding and incapacitate modules.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_MISSILEAIRDEFENSE"
msgstr "<p>Destroys missiles and squadrons flying near the ship. Requires timely activation.</p><p class=\"p_spacing\"> </p><p>Activating once is sufficient to destroy a homing missile. To destroy a guided missile or squadron, the laser must be activated twice.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_MISSILE_ALPHA"
msgstr "<p>Deals damage to energy shields and ships without energy shields. Do not require manual targeting.</p><p class=\"p_spacing\"> </p><p>Requires target scanning to launch.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_MISSILE_BETA"
msgstr "<p>Deals significant damage to ships without energy shields. Does not damage energy shields.</p><p class=\"p_spacing\"> </p><p>Requires manual targeting.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_MISSILE_MISSILE"
msgstr "They are launched from deck-mounted missile launchers. Upon hitting an enemy ship, they inflict damage."

msgid "IDS_DOCK_AMMO_DESCRIPTION_PINGER"
msgstr "<p>Hitting an enemy ship with a sonar pulse marks a sector on it for homing acoustic torpedoes.</p><p class=\"p_spacing\"> </p><p>Hitting the marked sector again extends its duration and increases the maneuverability of torpedoes homing in on it.</p><p class=\"p_spacing\"> </p><p>Launched torpedoes home in on the priority target - the last marked sector.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_PINGER_OVERRIDE_FOR_WEB"
msgstr "<p>A sonar pulse hit on an enemy ship marks a sector for acoustic torpedo targeting.</p><p class=\"p_spacing\"> </p><p>A second hit on the marked sector extends its duration and increases the maneuverability of torpedoes targeting it.</p><p class=\"p_spacing\"> </p><p>Launched torpedoes target the last marked sector.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_SECTOR_WAVE"
msgstr ""
"Features:\n"
" • The wave can strike several targets\n"
" • Damage dealt is proportional to the size of the impact area\n"
" • Can destroy enemy torpedoes and waves"

msgid "IDS_DOCK_AMMO_DESCRIPTION_SECTOR_WAVE_SMF_WAVE_GUN"
msgstr "Waves sink eggs and sharks and destroy waves fired by rival ships."

msgid "IDS_DOCK_AMMO_DESCRIPTION_SKIP_HE"
msgstr "<p>Attacks with a series of high-explosive bombs that travel toward the target by skipping over the water surface.</p><p class=\"p_spacing\"> </p><p>High-explosive bombs can cause fires and incapacitate modules.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_SKIP_HE_ALT"
msgstr "<p>Attacks the target with a series of powerful</p><p class=\"p_spacing\"> </p><p>high-explosive bombs.</p><p class=\"p_spacing\"> </p><p>High chance of setting the target on fire.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_SS"
msgstr "<p>Upon hitting the water surface, they create a smoke screen at the point of impact. Upon hitting a ship, they create a smoke screen that moves along with it.</p><p class=\"p_spacing\"> </p><p>The smoke screen reduces the chance of being detected by the enemy.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO"
msgstr "<p>Deals significant damage and can cause flooding.</p><p class=\"p_spacing\"> </p><p>Most effective against large and less maneuverable targets.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_ACID_FIRST_APRIL23"
msgstr ""
"Most effective against slow-moving, sluggish duckies. Maneuverable targets have high chances of ducking out of the way of quattacks.\n"
"\n"
"Hiss playfully when submerging."

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_ALTERNATIVE"
msgstr "<p>Deals significant damage and can cause flooding.</p><p class=\"p_spacing\"> </p><p>Most effective against large and less maneuverable targets.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_ALTERNATIVE_SUBBURN"
msgstr "<p>Can cause fires, flooding, and incapacitate modules. They deal low damage.</p><p class=\"p_spacing\"> </p><p>Most effective against large and less maneuverable targets.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_ALTERNATIVE_SUBCRIT"
msgstr "<p>Deals significant damage and can cause flooding.</p><p class=\"p_spacing\"> </p><p>Most effective against large and less maneuverable targets.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_ALTERNATIVE_SUBFLOOD"
msgstr "<p>Home in on enemy ships with a highlighted sector. Torpedo maneuverability and damage are enhanced against targets with a sector highlighted twice by sonar.</p><p class=\"p_spacing\"> </p><p>Especially effective against lightly armored targets.</p><p class=\"p_spacing\"> </p><p>High chances of causing flooding.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_ALTERNATIVE_SUPERSHIP"
msgstr "Most effective against large, armored targets. Maneuverable ships have high chances of dodging torpedo attacks."

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_DEEPWATER"
msgstr "<p>Deals significant damage and can cause flooding.</p><p class=\"p_spacing\"> </p><p>Low visibility, but only hits ships with a deep draft.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_DEEPWATER_SUBCRIT"
msgstr "<p>Deals significant damage and can cause flooding.</p><p class=\"p_spacing\"> </p><p>Low visibility, but only affects ships with a high draft.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_EVENT_HW20"
msgstr "Most effective against large, armored targets. Maneuverable ships have high chances of dodging torpedo attacks."

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_PLAZMA_EVENT_HW20"
msgstr ""
"Features:\n"
" • Subsequent hits to the same area of the ship deal increased damage."

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_STUN_EVENT_HW20"
msgstr ""
"Features:\n"
" • Torpedoes temporarily incapacitate enemy armaments"

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_SUBBURN"
msgstr "<p>Can cause fires, flooding, and incapacitate modules, but deals low damage.</p><p class=\"p_spacing\"> </p><p>Most effective against large and less maneuverable targets.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_SUBDEFAULT"
msgstr "<p>Home in on enemy ships, deal significant damage, and can cause flooding.</p><p class=\"p_spacing\"> </p><p>Before launching each torpedo, you must mark an enemy ship with a sonar pulse for homing. Switching between sonar and torpedo tubes happens automatically.</p><p class=\"p_spacing\"> </p><p>Effective against maneuverable and lightly armored targets.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_SUBDEFAULT_IMPROVE"
msgstr "<p>Home in on enemy ships, deal significant damage, and can cause flooding.</p><p class=\"p_spacing\"> </p><p>Before launching each torpedo, you must mark an enemy ship with a sonar pulse for homing. Switching between sonar and torpedo tubes happens automatically.</p><p class=\"p_spacing\"> </p><p>Effective against maneuverable and lightly armored targets.</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_SUPERSHIP"
msgstr "Most effective against large, armored targets. Maneuverable ships have high chances of dodging torpedo attacks."

