msgstr "Mastery Level"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Mastery reflects your proficiency with a specific ship and your combat experience on it. The mastery level is displayed next to the ship's name."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Available only for Tier V–X ships and Super Ships."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_2_HEADER"
msgstr "Progress"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_2_TEXT_1"
msgstr "To advance to the next mastery level, you must accumulate a certain amount of base experience."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_2_TEXT_2"
msgstr "The higher the ship's tier and your mastery level on it, the more base experience you need to earn to advance to the next mastery level."

