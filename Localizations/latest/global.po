msgstr "Battles in which you will test changes made to submarines and the tools for countering them."

msgid "IDS_PCVE030"
msgstr "Waffenträger: Isolation"

msgid "IDS_PCVE030_DESCRIPTION"
msgstr "Asymmetric battles between Ermelinda Jung and the Hounds. Choose your side and find your tactic!"

msgid "IDS_PCVE030_HOUND_BATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "RETURN TO BATTLE"

msgid "IDS_PCVE030_HOUND_BATTLE_RULES_PARAGRAPH_1_TEXT_1"
